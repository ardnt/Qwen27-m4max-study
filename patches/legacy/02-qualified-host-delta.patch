+// Opt-in, tokenizer-verified marker. No model-specific token IDs are built in.
+const std::vector<uint32_t> &branchMarker() {
+  static const std::vector<uint32_t> marker = [] {
+    std::vector<uint32_t> result;
+    const char *cursor = std::getenv("SPLASH_BRANCH_MARKER_IDS");
+    if (!cursor || !*cursor) return result;
+    while (*cursor) {
+      char *end = nullptr;
+      if (*cursor < '0' || *cursor > '9') return std::vector<uint32_t>{};
+      const unsigned long value = std::strtoul(cursor, &end, 10);
+      if (value > std::numeric_limits<uint32_t>::max() || end == cursor ||
+          (*end && *end != ',')) return std::vector<uint32_t>{};
+      result.push_back(static_cast<uint32_t>(value));
+      if (result.size() > 16) return std::vector<uint32_t>{};
+      cursor = *end ? end + 1 : end;
+    }
+    return result;
+  }();
+  return marker;
+}
 
